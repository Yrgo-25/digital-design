wR"}]}}],"NotGate":[{"x":610,"y":50,"objectType":"NotGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1],"nodes":{"output1":38,"inp1":37}}},{"x":610,"y":-100,"objectType":"NotGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1],"nodes":{"output1":43,"inp1":42}}},{"x":480,"y":310,"objectType":"NotGate","label":"","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",1],"nodes":{"output1":50,"inp1":49}}},{"x":940,"y":-130,"objectType":"NotGate","label":"","direction":"LEFT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["LEFT",1],"nodes":{"output1":76,"inp1":75}}},{"x":940,"y":20,"objectType":"NotGate","label":"","direction":"LEFT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["LEFT",1],"nodes":{"output1":80,"inp1":79}}}],"AndGate":[{"x":740,"y":80,"objectType":"AndGate","label":"button0_edge","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",2,1],"nodes":{"inp":[24,25],"output1":26}}},{"x":740,"y":-70,"objectType":"AndGate","label":"button1_edge","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"constructorParamaters":["RIGHT",2,1],"nodes":{"inp":[34,35],"output1":36}}}],"ConstantVal":[{"x":610,"y":150,"objectType":"ConstantVal","label":"preset","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":13},"constructorParamaters":["UP",1,"1"]}},{"x":610,"y":0,"objectType":"ConstantVal","label":"preset","direction":"UP","labelDirection":"DOWN","propagationDelay":0,"customData":{"nodes":{"output1":85},"constructorParamaters":["UP",1,"1"]}}],"DflipFlop":[{"x":610,"y":100,"objectType":"DflipFlop","label":"button0_prev","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"nodes":{"clockInp":4,"dInp":5,"qOutput":6,"qInvOutput":7,"reset":8,"preset":9,"en":10},"constructorParamaters":["RIGHT",1]}},{"x":610,"y":-50,"objectType":"DflipFlop","label":"button1_prev","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"nodes":{"clockInp":17,"dInp":18,"qOutput":19,"qInvOutput":20,"reset":21,"preset":22,"en":23},"constructorParamaters":["RIGHT",1]}},{"x":940,"y":-80,"objectType":"DflipFlop","label":"led1_state","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"nodes":{"clockInp":51,"dInp":52,"qOutput":53,"qInvOutput":54,"reset":55,"preset":56,"en":57},"constructorParamaters":["RIGHT",1]}},{"x":940,"y":70,"objectType":"DflipFlop","label":"led0_state","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"nodes":{"clockInp":58,"dInp":59,"qOutput":60,"qInvOutput":61,"reset":62,"preset":63,"en":64},"constructorParamaters":["RIGHT",1]}}],"Clock":[{"x":420,"y":280,"objectType":"Clock","label":"clock","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":3},"constructorParamaters":["RIGHT"]}}],"DigitalLed":[{"x":1040,"y":-130,"objectType":"DigitalLed","label":"led1","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Green"],"nodes":{"inp1":83}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}},{"x":1040,"y":20,"objectType":"DigitalLed","label":"led0","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Blue"],"nodes":{"inp1":84}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}}],"Text":[{"x":310,"y":360,"objectType":"Text","label":"För varje delkrets med button_n, button_prev_n, button_edge, led_state samt led gäller att:\n\n- Vippan button_prev_n lagrar föregående värde på button_n, dvs. tryckknappens värde från föregående klockcykel:\n  - Vid reset (reset_n = 0) sätts button_prev_n = 1 (via satt preset), eftersom button_n är aktiv låg.\n  - När klockan slår uppdateras button_prev_n till det aktuella värdet på button_n, dvs. button_prev_n = button_n.\n\n- AND-grinden button_edge blir etta vid fallande flank på button_n, dvs. i det ögonblick då knappen trycks ned:\n  - Då gäller att button_n = 0 (knappen är nu nedtryckt) och button_prev_n = 1 (knappen var inte nedtryckt under föregående klockcykel).\n  - Algebraiskt kan detta skrivas som  \n    button_edge = button_n' & button_prev_n.\n\n- Vippan led_state togglas när button_edge = 1, dvs. vid fallande flank på button_n, eftersom button_edge är ansluten till dess enable-ingång:\n  - Vid reset (reset_n = 0) sätts led_state = 0, vilket släcker den anslutna lysdioden led.\n  - När klockan slår togglas led_state om button_edge = 1, annars behålls föregående värde.\n  - OBS! Om button_edge inte hade varit ansluten till enable-ingången hade led_state togglats vid varje klockcykel.\n\n- led är direkt ansluten till led_state, vilket innebär att lysdioden tänds eller släcks beroende på värdet på led_state.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["För varje delkrets med button_n, button_prev_n, button_edge, led_state samt led gäller att:\n\n- Vippan button_prev_n lagrar föregående värde på button_n, dvs. tryckknappens värde från föregående klockcykel:\n  - Vid reset (reset_n = 0) sätts button_prev_n = 1 (via satt preset), eftersom button_n är aktiv låg.\n  - När klockan slår uppdateras button_prev_n till det aktuella värdet på button_n, dvs. button_prev_n = button_n.\n\n- AND-grinden button_edge blir etta vid fallande flank på button_n, dvs. i det ögonblick då knappen trycks ned:\n  - Då gäller att button_n = 0 (knappen är nu nedtryckt) och button_prev_n = 1 (knappen var inte nedtryckt under föregående klockcykel).\n  - Algebraiskt kan detta skrivas som  \n    button_edge = button_n' & button_prev_n.\n\n- Vippan led_state togglas när button_edge = 1, dvs. vid fallande flank på button_n, eftersom button_edge är ansluten till dess enable-ingång:\n  - Vid reset (reset_n = 0) sätts led_state = 0, vilket släcker den anslutna lysdioden led.\n  - När klockan slår togglas led_state om button_edge = 1, annars behålls föregående värde.\n  - OBS! Om button_edge inte hade varit ansluten till enable-ingången hade led_state togglats vid varje klockcykel.\n\n- led är direkt ansluten till led_state, vilket innebär att lysdioden tänds eller släcks beroende på värdet på led_state.",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[11,12,14,15,16,27,28,29,30,31,32,33,39,40,41,44,45,46,47,48,65,66,67,68,69,70,71,72,73,74,77,78,81,82,86,87,88,89,90,91,92,93]}]}