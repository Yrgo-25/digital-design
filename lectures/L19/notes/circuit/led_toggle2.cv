:{"clockInp":48,"dInp":49,"qOutput":50,"qInvOutput":51,"reset":52,"preset":53,"en":54},"constructorParamaters":["RIGHT",1]}},{"x":1440,"y":160,"objectType":"DflipFlop","label":"led_state","direction":"RIGHT","labelDirection":"UP","propagationDelay":10,"customData":{"nodes":{"clockInp":69,"dInp":70,"qOutput":71,"qInvOutput":72,"reset":73,"preset":74,"en":75},"constructorParamaters":["RIGHT",1]}}],"Clock":[{"x":380,"y":430,"objectType":"Clock","label":"clock","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":0,"customData":{"nodes":{"output1":2},"constructorParamaters":["RIGHT"]}}],"DigitalLed":[{"x":1560,"y":110,"objectType":"DigitalLed","label":"led","direction":"UP","labelDirection":"DOWN","propagationDelay":10,"customData":{"constructorParamaters":["Red"],"nodes":{"inp1":68}},"subcircuitMetadata":{"showInSubcircuit":false,"showLabelInSubcircuit":true,"labelDirection":"DOWN","x":0,"y":0}}],"Text":[{"x":620,"y":470,"objectType":"Text","label":"reset_s2_n är vår stabila reset-signal, som används i resten av nätet.\n\nVi lägger till två vippor för att stabilisera knappsignalen, samt en tredje för att implementera flankdetektering:\n    - button_s2_n är \"nuvarande\" värde. \n    - button_s3_n är \"föregående\" värde.\n\nVi detekterar fallande flank på button_n med button_edge_s2:\n    - button_edge_s2 = 1 när button_s2_n = 0 och button_s3_n = 1.\n    - Med andra ord, knappen är nu nedtryckt, men var inte dess klockpulsen innan.\n\nled_state håller lysdiodens tillstånd:\n    - Vi skapar en toggle-vippa genom att koppla inversen av utsignalen till ingången.\n    - Vi kopplar button_edge_s2 till enable-ingången så att toggling bara sker vid fallande flank, dvs. när button_edge_s2 = 1.","direction":"RIGHT","labelDirection":"LEFT","propagationDelay":10,"customData":{"constructorParamaters":["reset_s2_n är vår stabila reset-signal, som används i resten av nätet.\n\nVi lägger till två vippor för att stabilisera knappsignalen, samt en tredje för att implementera flankdetektering:\n    - button_s2_n är \"nuvarande\" värde. \n    - button_s3_n är \"föregående\" värde.\n\nVi detekterar fallande flank på button_n med button_edge_s2:\n    - button_edge_s2 = 1 när button_s2_n = 0 och button_s3_n = 1.\n    - Med andra ord, knappen är nu nedtryckt, men var inte dess klockpulsen innan.\n\nled_state håller lysdiodens tillstånd:\n    - Vi skapar en toggle-vippa genom att koppla inversen av utsignalen till ingången.\n    - Vi kopplar button_edge_s2 till enable-ingången så att toggling bara sker vid fallande flank, dvs. när button_edge_s2 = 1.",14]}}],"restrictedCircuitElementsUsed":[],"nodes":[10,11,14,22,23,24,32,33,34,36,44,45,46,47,55,56,57,58,62,63,66,67,78,79,80,81,82,83,84,85,86,87]}]}